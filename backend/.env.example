# ==========================================
# Amsterdam Group E-Commerce Ordering System
# Backend Environment Configuration
# ==========================================

PROJECT_NAME="Amsterdam Group Ordering API"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL / SQLite for local tests)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/amsterdam_db
DATABASE_URL="sqlite:///./amsterdam.db"

# Security & Authentication
SECRET_KEY="amsterdam-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Created automatically on startup if not exists)
ADMIN_DEFAULT_NAME="Amsterdam Admin"
ADMIN_DEFAULT_EMAIL="admin@amsterdamgroup.co.tz"
ADMIN_DEFAULT_PASSWORD="Admin@Amsterdam2026!"

# WhatsApp Notification & Ordering
# Format: International format without symbols or spaces (e.g. 255700000000)
WHATSAPP_NUMBER="255700000000"

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Static File Uploads
STATIC_DIR="app/static"
MEDIA_BASE_URL="http://localhost:8000/static"
