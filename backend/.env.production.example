# ==========================================
# Amsterdam Group - Backend Production Environment Variables
# Copy these values into Railway -> Service -> Variables
# ==========================================

# Application Metadata
PROJECT_NAME="Amsterdam Group Ordering API"
ENVIRONMENT=production
DEBUG=False

# Database: Automatically provided by Railway when attaching PostgreSQL
# (Railway sets DATABASE_URL automatically to postgresql://...)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Security: Generate a secure 32+ character random string
SECRET_KEY=amsterdam-production-secret-change-this-random-string-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Seeded on first startup)
ADMIN_DEFAULT_NAME="Amsterdam Admin"
ADMIN_DEFAULT_EMAIL=admin@amsterdamgroup.co.tz
ADMIN_DEFAULT_PASSWORD=Admin@Amsterdam2026!

# Official WhatsApp Business Order Line (E.164 format without '+' e.g. 255651728851)
# (Can also be updated anytime directly inside the Admin Console Settings!)
WHATSAPP_NUMBER=255651728851

# Allowed CORS Origins:
# Set to * or include your Vercel deployment URL
CORS_ORIGINS="*"

# Static Assets Directory
STATIC_DIR=app/static
